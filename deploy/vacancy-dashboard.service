# Юнит systemd для дашборда рынка вакансий hh.ru.
#
#   sudo cp deploy/vacancy-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vacancy-dashboard
#
# Юнит управляет стеком Docker Compose, а не голым процессом Streamlit: тот же
# compose-файл используется локально, в CI и в бою, поэтому описание того, как
# запускается дашборд, ровно одно.

[Unit]
Description=Дашборд рынка вакансий hh.ru (стек Docker Compose)
Documentation=https://github.com/MeldanLess/vacancy-dashboard
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vacancy-dashboard

# `up -d` возвращается, как только контейнер запущен; сам дашборд дожидается,
# пока отрапортует о состоянии healthy, и только потом считается поднятым.
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down
ExecReload=/usr/bin/docker compose -f docker-compose.prod.yml pull && /usr/bin/docker compose -f docker-compose.prod.yml up -d

TimeoutStartSec=0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
